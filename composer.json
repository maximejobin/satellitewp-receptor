{
    "name": "satellitewp/manager",
    "description": "SatelliteWP server-side extractor and validation pipeline for site extractions",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/console": "^7.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SatelliteWP\\Manager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SatelliteWP\\Manager\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "suggest": {
        "ext-pdo_mysql": "Required only when the CRM database (crm_db.*) is configured"
    },
    "scripts": {
        "test": "phpunit",
        "test:mysql": "phpunit --group mysql",
        "analyse": "phpstan analyse",
        "check": [
            "@test",
            "@analyse"
        ]
    }
}
