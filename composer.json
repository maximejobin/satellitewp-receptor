{
    "name": "satellitewp/xtractor",
    "description": "SatelliteWP server-side receptor and validation pipeline for site extractions",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "guzzlehttp/guzzle": "^7.9",
        "symfony/console": "^7.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "SatelliteWP\\Xtractor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SatelliteWP\\Xtractor\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
